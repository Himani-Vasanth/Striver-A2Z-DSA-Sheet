#include <iostream>
using namespace std;

int main() {
    int age;
    cin >> age;

    if (age >= 18) {
        cout << "Adult";
    } else {
        cout << "Minor";
    }

    int marks;
    cin >> marks;

    if (marks < 25) {
        cout << "F";
    } else if (marks <= 44) {
        cout << "E";
    } else if (marks <= 49) {
        cout << "D";
    } else if (marks <= 59) {
        cout << "C";
    } else if (marks <= 69) {
        cout << "B";
    } else {
        cout << "A";
    }

    int n;
    cin >> n;

    if (n > 0 && n % 2 == 0) {
        cout << "Positive Even";
    } else if (n > 0 && n % 2 != 0) {
        cout << "Positive Odd";
    } else if (n < 0) {
        cout << "Negative";
    } else {
        cout << "Zero";
    }

    int number;
    cin >> number;

    if (number > 10) {
        if (number % 2 == 0) {
            cout << "Greater than 10 and Even";
        } else {
            cout << "Greater than 10 and Odd";
        }
    } else {
        cout << "10 or Less";
    }

    return 0;
}
